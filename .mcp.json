{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.83",
        "--headless",
        "--browser",
        "chrome",
        "--viewport-size",
        "1920x1080",
        "--caps",
        "vision",
        "--config",
        "playwright-mcp.config.json"
      ],
      "env": {}
    }
  }
}